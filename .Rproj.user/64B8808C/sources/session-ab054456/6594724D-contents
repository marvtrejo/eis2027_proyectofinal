# 3. Descomposición de la desigualdad dentro y entre grupos
Esta sección:

* Define cinco formas de dividir a los hogares: 65+ contra el resto (nacional) y, dentro del grupo, por tipo de transferencia, ámbito de residencia (rural/urbano), sexo de la jefatura y tipo × ámbito.
* Para cada división separa la desigualdad total en dos partes: la que hay dentro de cada subgrupo y la que hay entre subgrupos. Usa dos medidas y comprueba que las partes sumen el total.
* Cuenta cuántos hogares quedan fuera por tener ingreso cero.
* Compara hogares con jefatura femenina y masculina: tamaño del hogar y tipo de transferencia que reciben. 
* Genera los cuadros 3.1 (la descomposición) y 3.2 (% de hogares, ingreso medio y desigualdad interna de cada subgrupo), así como la gráfica 3.1 (qué % explica la parte “entre”).

## Cálculo

```{r}
#| label: t3-descomp

pobs3 <- list(Nacional = disenios, `Hogares 65+` = grupos)
agrup <- 
  list("Nacional: 65+ vs resto"     = c("Nacional",    "g65f"),
       "65+: tipo de transferencia" = c("Hogares 65+", "tipo_tr"),
       "65+: ámbito (urbano/rural)" = c("Hogares 65+", "ambito"),
       "65+: sexo de la jefatura"   = c("Hogares 65+", "jefatura"),
       "65+: tipo × ámbito"         = c("Hogares 65+", "tipo_amb"))

etq_c <- c(total = "Total", within = "Dentro", between = "Entre")

# GE(0) y GE(1): total, dentro y entre, con EE del diseño.

t3 <- function(d, g) bind_rows(lapply(c(`GE(0)` = 0, `GE(1) Theil` = 1), function(e) {
  r <- svygeidec(~ing_cor, g, subset(d, ing_cor > 0), epsilon = e)
  stopifnot(abs(coef(r)[["within"]] + coef(r)[["between"]] - coef(r)[["total"]]) < 1e-8)
  data.frame(comp = etq_c[names(coef(r))], 
             est = as.numeric(coef(r)), 
             se = as.numeric(SE(r)))
}), .id = "indice")

t3_desc <- lapply(agrup, 
                  function(a) bind_rows(lapply(pobs3[[a[1]]], 
                                               t3, 
                                               g = reformulate(a[2])),
                                               .id = "anio")) %>%
  bind_rows(.id = "agrup") %>%
  group_by(agrup, anio, indice) %>%
  mutate(pct = 100 * est / est[comp == "Total"], 
         cv = 100 * se / est) %>%
  ungroup()

# Hogares en muestra excluidos por ingreso ≤ 0, por población
excl <- sapply(list(`2022` = base22, `2024` = base24), 
               function(b)
                 c(nac = sum(b$ing_cor <= 0), 
                   g65 = sum(b$ing_cor <= 0 & b$g65 == 1)))

prueba_jef <- lapply(grupos, function(g) {
  tt <- svyttest(tot_integ ~ jefatura, g)           
  ch <- svychisq(~jefatura + tipo_tr, g)             # Rao-Scott (F), ajustada por diseño
  data.frame(prueba = c("Integrantes del hogar (t)", 
                        "Jefatura × tipo de transferencia (F)"),
             dif    = c(unname(tt$estimate), NA),
             estad  = c(unname(tt$statistic), unname(ch$statistic)),
             p      = unname(c(tt$p.value, ch$p.value)))
}) %>% bind_rows(.id = "anio")

prueba_jef
