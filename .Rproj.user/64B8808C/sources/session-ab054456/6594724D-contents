                               j = num, 
                               align = "right", 
                               part = "body")
  if (nb %% 2 == 1) 
    ft <- hline_bottom(ft, 
                       border = officer::fp_border(color = "#C0C0C0",
                                                   width = 1), 
                       part = "body")
  ft
}

