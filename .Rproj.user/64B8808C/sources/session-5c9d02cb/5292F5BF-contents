/* Importar Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Gabarito:wght@400;700&family=Inter:wght@400;500;700&display=swap');

/* ===== Tipografía global ===== */
body {
  font-family: 'Inter', sans-serif;
  font-size: 16px;
  color: #333333;
  line-height: 1.6;
  background-color: #ffffff;
}

/* ===== Encabezados ===== */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Gabarito', serif;
  color: #004d66;
  font-weight: 700;
  margin-top: 1.5em;
  margin-bottom: 0.5em;
}

/* ===== Links ===== */
a {
  color: #008080;
  text-decoration: none;
  transition: color 0.2s ease-in-out;
}
a:hover {
  color: #004d66;
  text-decoration: underline;
}

/* ===== Tarjetas del Blog (Listado Grid de Quarto) ===== */
/* Rediseñado para un look minimalista, eliminando el gris pesado */
.quarto-listing-cards .card {
  border: 1px solid #eaeaea;
  border-radius: 8px;
  background-color: #ffffff; 
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* Efecto hover sutil usando el acento principal */
.quarto-listing-cards .card:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 16px rgba(0, 128, 128, 0.12); 
}

/* ===== Títulos y textos dentro de las tarjetas ===== */
.quarto-listing-cards .card-title {
  font-family: 'Gabarito', serif;
  font-weight: 700;
  color: #004d66;
}
.quarto-listing-cards .card-text {
  font-family: 'Inter', sans-serif;
  color: #555555;
}

/* ===== Estilo de listas ===== */
ul, ol {
  margin-left: 1.5rem;
  margin-bottom: 1rem;
}

/* ===== Tablas Markdown ===== */
/* Restringido a las tablas de contenido para no dañar componentes nativos */
table.table {
  border-bottom: 2px solid #008080;
  margin-bottom: 1.5rem;
}
table.table th {
  font-family: 'Gabarito', serif;
  background-color: #f8f9fa;
  border-top: 2px solid #008080;
}
table.table th, table.table td {
  padding: 0.75rem;
  border-bottom: 1px solid #eaeaea;
}

/* ===== Barra de navegación ===== */
.navbar {
  font-weight: 700;
  font-family: 'Gabarito', serif;
}