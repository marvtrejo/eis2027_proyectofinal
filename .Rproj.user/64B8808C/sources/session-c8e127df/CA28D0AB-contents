```{r}
#| label: t2-grafica-distribucion
pal <- c("2022" = "grey60", "2024" = "#9b2247")
tema <- theme_classic() + theme(legend.position = "top", plot.caption.position = "plot",
                                plot.caption = element_text(hjust = 0))
dodge <- position_dodge(.8)

g_t2a <- ggplot(t2, aes(factor(decil), p_g, fill = anio)) +
  geom_col(position = dodge, width = .75) +
  geom_errorbar(aes(ymin = p_g - z * se_g, ymax = p_g + z * se_g), position = dodge, width = .2) +
  geom_hline(yintercept = 10, linetype = "dashed") +
  scale_fill_manual(values = pal) + scale_x_discrete(labels = as.roman(1:10)) +
  labs(title = "Gráfica 2.1. Distribución de los hogares con 65+ por decil nacional",
       subtitle = "Línea punteada: 10% (sin relación entre grupo y decil). Barras: IC 95%",
       x = "Decil nacional de ingreso corriente per cápita", y = "% de los hogares del grupo",
       fill = NULL, caption = fuente) + tema
g_t2a
```

```{r}
