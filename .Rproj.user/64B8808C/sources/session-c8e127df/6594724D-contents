# Tarea 5: Cambio 2022–2024 y su significancia estadística

## Cálculo

```{r}
#| label: t5-calculo
etq5 <- c(gini       = "Gini",
          theil      = "Theil T",
          media      = "Ingreso corriente medio (pesos de 2018)",
          transfer   = "Peso de transferencias (%)",
          jubilacion = "Peso de jubilaciones (%)",
          bene_gob   = "Peso de programas gob. (%)")

# Indicadores de un diseño (grupo o resto) en un año
ind_t5 <- function(g) {
  x <- list(svygini(~ing_cor, g),
            svygei(~ing_cor, subset(g, ing_cor > 0), epsilon = 1),
            svymean(~ing_cor, g),
            svyratio(~transfer + jubilacion + bene_gob, ~ing_cor, g))
  data.frame(ind = names(etq5),
             est = unlist(lapply(x, coef), use.names = FALSE),
             se  = unlist(lapply(x, \(o) as.numeric(SE(o))))) %>%
    mutate(across(c(est, se), ~ if_else(ind %in% c("transfer", "jubilacion", "bene_gob"), .x * 100, .x)))
}

# Prueba de diferencia entre años (encuestas independientes); sirve para Cuadros 5.1 y 5.2
prueba <- function(df) df %>%
  pivot_wider(names_from = anio, values_from = c(est, se)) %>%
  mutate(dif = est_2024 - est_2022, se_dif = sqrt(se_2022^2 + se_2024^2),
         li = dif - z * se_dif, ls = dif + z * se_dif,
         p = 2 * pnorm(-abs(dif / se_dif)), sig = if_else(p < .05, "Sí", "No")) %>%
  select(pob, ind, est_2022, se_2022, est_2024, se_2024, dif, se_dif, li, ls, p, sig)

pobs5 <- list(`Hogares con 65+` = grupos,
              Resto             = list(`2022` = subset(d22, g65 == 0), `2024` = subset(d24, g65 == 0)))

t5_largo <- lapply(pobs5, \(ds) lapply(ds, ind_t5) %>% bind_rows(.id = "anio")) %>%
  bind_rows(.id = "pob")

t5_dif <- prueba(t5_largo) %>% mutate(ind = etq5[ind])

# Hogares en muestra con ingreso 0 que excluye el Theil (orden: grupo 22, grupo 24, resto 22, resto 24)
n_cero <- sapply(unlist(pobs5, recursive = FALSE), \(d) sum(weights(d) > 0 & d$variables$ing_cor == 0))
