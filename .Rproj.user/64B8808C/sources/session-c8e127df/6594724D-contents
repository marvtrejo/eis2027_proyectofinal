# Tarea 3: Descomposición de la desigualdad dentro y entre grupos

## Cálculo

```{r}
#| label: t3-descomp
# Agrupaciones PROVISIONALES (pendiente: confirmar con el profesor). Una línea por agrupación.
pobs3 <- list(Nacional = disenios, `Hogares 65+` = grupos)
agrup <- list("Nacional: 65+ vs resto"     = c("Nacional",    "g65f"),
              "65+: tipo de transferencia" = c("Hogares 65+", "tipo_tr"),
              "65+: ámbito (urbano/rural)" = c("Hogares 65+", "ambito"),
              "65+: sexo de la jefatura"   = c("Hogares 65+", "jefatura"),
              "65+: tipo × ámbito"         = c("Hogares 65+", "tipo_amb"))
etq_c <- c(total = "Total", within = "Dentro", between = "Entre")

# GE(0) y GE(1): total, dentro y entre, con EE del diseño. GE exige ingreso > 0
t3 <- function(d, g) bind_rows(lapply(c(`GE(0)` = 0, `GE(1) Theil` = 1), function(e) {
  r <- svygeidec(~ing_cor, g, subset(d, ing_cor > 0), epsilon = e)
  stopifnot(abs(coef(r)[["within"]] + coef(r)[["between"]] - coef(r)[["total"]]) < 1e-8)
  data.frame(comp = etq_c[names(coef(r))], est = as.numeric(coef(r)), se = as.numeric(SE(r)))
}), .id = "indice")

t3_desc <- lapply(agrup, function(a) bind_rows(lapply(pobs3[[a[1]]], t3, g = reformulate(a[2])),
                                               .id = "anio")) %>%
  bind_rows(.id = "agrup") %>%
  group_by(agrup, anio, indice) %>%
  mutate(pct = 100 * est / est[comp == "Total"], cv = 100 * se / est) %>%
  ungroup()

# Hogares en muestra excluidos por ingreso ≤ 0, por población
excl <- sapply(list(`2022` = base22, `2024` = base24), function(b)
