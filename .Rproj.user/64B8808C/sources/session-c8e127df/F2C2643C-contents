  decil        = romanos[cv_dec_22$decil],
  n_22         = n_dec_22[[2]],
  cv_jub_22    = cv_dec_22$cv.jubilacion * 100,
  prec_jub_22  = case_when(cv_jub_22 < 15 ~ "Alta", cv_jub_22 < 30 ~ "Moderada", TRUE ~ "Baja"),
  cv_bene_22   = cv_dec_22$cv.bene_gob * 100,
  prec_bene_22 = case_when(cv_bene_22 < 15 ~ "Alta", cv_bene_22 < 30 ~ "Moderada", TRUE ~ "Baja")
)

d3_24 <- tibble(
  decil        = romanos[cv_dec_24$decil],
  n_24         = n_dec_24[[2]],
  cv_jub_24    = cv_dec_24$cv.jubilacion * 100,
  prec_jub_24  = case_when(cv_jub_24 < 15 ~ "Alta", cv_jub_24 < 30 ~ "Moderada", TRUE ~ "Baja"),
  cv_bene_24   = cv_dec_24$cv.bene_gob * 100,
  prec_bene_24 = case_when(cv_bene_24 < 15 ~ "Alta", cv_bene_24 < 30 ~ "Moderada", TRUE ~ "Baja")
