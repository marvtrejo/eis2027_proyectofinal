g24 <- update(g24, uno = 1)

# CVs por decil
cv_dec_22 <- svyby(~jubilacion + bene_gob, ~decil, g22, svymean, vartype = "cv")
cv_dec_24 <- svyby(~jubilacion + bene_gob, ~decil, g24, svymean, vartype = "cv")

# Tamanos muestrales por decil
n_dec_22 <- svyby(~uno, ~decil, g22, unwtd.count)
n_dec_24 <- svyby(~uno, ~decil, g24, unwtd.count)

