# Tarea 2. Ubicación del grupo en la distribución nacional del ingreso
## Cálculo
```{r}
#| label: t2-control
# Control: cada decil nacional debe concentrar ~10% de los hogares.
# Si hay empates (p. ej. muchos ictpc = 0) los deciles bajos se desbalancean.
round(100 * coef(svymean(~factor(decil), d24)), 2)
round(100 * coef(svymean(~factor(decil), d22)), 2)
```

```{r}
#| label: t2-calculo

z <- qnorm(.975)
fuente <- "Fuente: elaboración propia con datos de la ENIGH 2022 y 2024, INEGI."

# Por decil nacional: límite superior, % del grupo en el decil y % del decil que es del grupo
ubica <- function(b, d, g, anio) {
  dist <- svymean(~factor(decil), g)        # distribución del grupo (referencia: 10%)
  comp <- svyby(~g65, ~decil, d, svymean)   # composición del decil (referencia: % nacional)
  b %>% group_by(decil) %>% summarise(lim_sup = max(ing_cor)) %>%
    mutate(anio = anio,
           p_g = 100 * coef(dist), se_g = 100 * SE(dist),
           p_d = 100 * coef(comp), se_d = 100 * SE(comp),
           cv_g = 100 * se_g / p_g, cv_d = 100 * se_d / p_d,
           prec_g = precision(cv_g), prec_d = precision(cv_d))
}

# Resumen: % del grupo en deciles I–III y VIII–X, y % de hogares del país en el grupo
resume <- function(d, g, anio) {
  r <- svymean(~I(100 * (decil <= 3)) + I(100 * (decil >= 8)), g)
  n <- svymean(~I(100 * g65), d)
  data.frame(anio, indicador = c("Grupo en deciles I–III", "Grupo en deciles VIII–X",
                                 "Hogares del país con 65+"),
             pct = c(coef(r), coef(n)), se = c(SE(r), SE(n))) %>%
    mutate(li = pct - z * se, ls = pct + z * se, cv = 100 * se / pct, precision = precision(cv))
}

t2     <- bind_rows(ubica(base22, d22, g22, "2022"), ubica(base24, d24, g24, "2024"))
t2_res <- bind_rows(resume(d22, g22, "2022"), resume(d24, g24, "2024"))
```

