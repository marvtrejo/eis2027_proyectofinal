# Tarea 4: Gini, Theil y curva de Lorenz

## Cálculo

```{r}
#| label: t4-funciones
# Desigualdad de una variable de ingreso en un (sub)diseño.
# Gini: todos los hogares del dominio. Theil T (GE(1)): solo hogares con ingreso > 0.
# El argumento v permite reutilizar la función en la Tarea 6 (ing_sin_bene, ing_sin_jub, ing_sin_trans).
desig <- function(d, v = "ing_cor") {
  f   <- reformulate(v)
  y   <- d$variables[[v]]
  gi  <- svygini(f, d)
  th  <- svygei(f, subset(d, y > 0), epsilon = 1)
  data.frame(ind  = c("Gini", "Theil T"),
             est  = c(coef(gi), coef(th)),
             se   = as.numeric(c(SE(gi), SE(th))),
             excl = c(NA, sum(weights(d) > 0 & y <= 0))) %>%   # hogares en muestra fuera del Theil
    mutate(cv = 100 * se / est, prec = precision(cv), .after = se)
}

# Dominios del diseño (subset sobre el diseño, nunca sobre la base)
dominios <- function(d) list(Nacional          = d,
                             Resto             = subset(d, g65 == 0),
                             `Hogares con 65+` = subset(d, g65 == 1))
disenios <- list(`2022` = d22, `2024` = d24)

# Formato largo: lo reutiliza la Tarea 5 (est y se por año)
cuadro5_df <- lapply(disenios, function(d) bind_rows(lapply(dominios(d), desig), .id = "pob")) %>%
  bind_rows(.id = "anio")
