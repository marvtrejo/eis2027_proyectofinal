base24 <- read.csv("concentradohogar24.csv")
 
precision <- function(cv) case_when(is.na(cv) ~ "–",
                                    cv < 15 ~ "Alta",
                                    cv < 30 ~ "Moderada",
                                    cv >= 30 ~ "Baja")
 
semaforo <- function(ft, cols) {
  for (j in cols) {
    x <- ft$body$dataset[[j]]
    ft <- ft %>% bg(i = !is.na(x) & x >= 15 & x < 30, j = j, bg = "#FFF2CC") %>%
                 bg(i = !is.na(x) & x >= 30, j = j, bg = "#FCE4D6")
  }
  ft
}
