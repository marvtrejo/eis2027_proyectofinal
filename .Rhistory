#| label: t3-subgrupos
# Por subgrupo: % de hogares, ingreso medio y GE(0) propio (hogares 65+ con ingreso > 0)
sub3 <- function(d, g) {
d  <- subset(d, ing_cor > 0)
m  <- svyby(~ing_cor, reformulate(g), d, svymean)
ge <- svyby(~ing_cor, reformulate(g), d, svygei, epsilon = 0)
data.frame(grupo = as.character(m[[1]]), pct = 100 * coef(svymean(reformulate(g), d)),
media = coef(m), cv_media = 100 * cv(m), ge0 = coef(ge), cv_ge0 = 100 * cv(ge))
}
t3_sub <- lapply(agrup[-1], function(a)              # [-1]: solo agrupaciones del grupo 65+
bind_rows(lapply(grupos, sub3, g = a[2]), .id = "anio")) %>%
bind_rows(.id = "agrup") %>%
pivot_wider(names_from = anio, values_from = -c(agrup, anio, grupo), names_vary = "slowest")
cuadro3_2 <- flextable(t3_sub) %>%
set_header_labels(values = c(agrup = "Agrupación", grupo = "Subgrupo", setNames(
rep(c("% hogares", "Ingreso medio", "CV (%)", "GE(0)", "CV (%)"), 2), names(t3_sub)[-(1:2)]))) %>%
add_header_row(values = c("", "2022", "2024"), colwidths = c(2, 5, 5)) %>%
merge_v(j = "agrup") %>%
theme_vanilla() %>%
colformat_double(digits = 1) %>%
colformat_double(j = c("media_2022", "media_2024"), digits = 0, big.mark = ",") %>%
colformat_double(j = c("ge0_2022", "ge0_2024"), digits = 3) %>%
semaforo(grep("^cv", names(t3_sub), value = TRUE)) %>%
set_caption("Cuadro 3.2. Ingreso medio y desigualdad por subgrupo, hogares con 65+, ENIGH 2022 y 2024") %>%
add_footer_lines(c(paste("Nota: hogares con ingreso corriente > 0. Ingreso corriente trimestral del hogar en pesos de 2018. GE(0) = desviación logarítmica media dentro de cada subgrupo.", nota_cv),
fuente)) %>%
fontsize(size = 9, part = "footer") %>%
autofit()
cuadro3_2
saveRDS(list(descomp = t3_desc, subgrupos = t3_sub, graf3_1 = graf3_1,
excl = excl, prueba_jef = prueba_jef), "salidas/t3_resultados.rds")
#| label: t4-funciones
# Desigualdad de una variable de ingreso en un (sub)diseño.
# Gini: todos los hogares del dominio. Theil T (GE(1)): solo hogares con ingreso > 0.
desig <- function(d, v = "ing_cor") {
f   <- reformulate(v)
y   <- d$variables[[v]]
gi  <- svygini(f, d)
th  <- svygei(f, subset(d, y > 0), epsilon = 1)
data.frame(ind  = c("Gini", "Theil T"),
est  = c(coef(gi), coef(th)),
se   = as.numeric(c(SE(gi), SE(th))),
excl = c(NA, sum(weights(d) > 0 & y <= 0))) %>%
mutate(cv = 100 * se / est, prec = precision(cv), .after = se)
}
# Dominios del diseño
dominios <- function(d) list(Nacional          = d,
Resto             = subset(d, g65 == 0),
`Hogares con 65+` = subset(d, g65 == 1))
t4_ind <- lapply(disenios, function(d) bind_rows(lapply(dominios(d),
desig),
.id = "pob")) %>%
bind_rows(.id = "anio")
#| label: t4-cotejo
# Cotejo del punto estimado nacional con dineq (sin diseño): deben coincidir en los primeros decimales
cotejo <- t4_ind %>%
filter(pob == "Nacional", ind == "Gini") %>%
select(anio, est) %>%
mutate(dineq = sapply(list(base22, base24), function(b) gini.wtd(b$ing_cor, b$factor)),
dif   = est - dineq)
cotejo
#| label: t4-colas
# Diagnóstico exploratorio: hogares con mayor ingreso y su peso en el ingreso total expandido.
# La sensibilidad de Gini y Theil a estos valores se evalúa en la Tarea 5 (Cuadro 5.2).
colas <- lapply(list(`2022` = base22, `2024` = base24), function(b) b %>%
slice_max(ing_cor, n = 5) %>%
transmute(ing_cor, factor, g65, upm, est_dis,
peso_pct = 100 * ing_cor * factor / sum(b$ing_cor * b$factor))) %>%
bind_rows(.id = "anio")
colas
#| label: t4-cuadro
t4_w <- t4_ind %>%
pivot_wider(names_from = anio, values_from = c(est, se, cv, prec, excl), names_vary = "slowest")
cuadro4_1 <- flextable(t4_w) %>%
set_header_labels(values = c(pob = "Hogares", ind = "Indicador", setNames(
rep(c("Estimación", "EE", "CV (%)", "Precisión", "Excluidos (n)"), 2), names(t4_w)[-(1:2)]))) %>%
add_header_row(values = c("", "2022", "2024"), colwidths = c(2, 5, 5)) %>%
merge_v(j = "pob") %>%
theme_vanilla() %>%
align(i = 1, align = "center", part = "header") %>%
colformat_double(digits = 4) %>%
colformat_double(j = c("cv_2022", "cv_2024"), digits = 2) %>%
semaforo(c("cv_2022", "cv_2024")) %>%
set_caption("Cuadro 4.1. Coeficiente de Gini e índice de Theil T del ingreso corriente del hogar, ENIGH 2022 y 2024") %>%
add_footer_lines(c(
paste("Nota: ingreso corriente total trimestral del hogar, sin ajuste por tamaño. Cada indicador mide la desigualdad dentro de su dominio. Gini con todos los hogares; Theil T solo con hogares de ingreso > 0 (Excluidos = hogares en muestra con ingreso 0). EE por linealización con el diseño muestral (convey). Sensibilidad a valores extremos: Cuadro 5.2.", nota_cv),
fuente)) %>%
fontsize(size = 9, part = "footer") %>%
autofit()
cuadro4_1
#| label: t4-grafica1
graf4_1 <- ggplot(t4_ind, aes(pob, est, colour = anio)) +
geom_pointrange(aes(ymin = est - z * se, ymax = est + z * se), position = position_dodge(.4)) +
facet_wrap(~ind, scales = "free_y") +
scale_colour_manual(values = pal) +
scale_x_discrete(limits = c("Nacional", "Resto", "Hogares con 65+")) +
labs(title = "Gráfica 4.1. Gini y Theil T del ingreso corriente del hogar por dominio, 2022 y 2024",
x = NULL, y = "Estimación", colour = "Año",
caption = paste("Nota: barras = IC 95%. Que los intervalos se traslapen o no, no equivale a una prueba de diferencia (ver Cuadro 5.1).",
fuente, sep = "\n")) +
tema
graf4_1
#| label: t4-lorenz
p <- seq(0, 1, .1)
lorenz <- function(d) {
l <- svylorenz(~ing_cor, d, quantiles = p, plot = FALSE)
stopifnot(length(coef(l)) == length(p))
data.frame(p, L = as.numeric(coef(l)), se = as.numeric(SE(l)))
}
lorenz_df <- lapply(disenios, function(d) bind_rows(lapply(dominios(d)[-1], lorenz), .id = "pob")) %>%
bind_rows(.id = "anio") %>%
mutate(li = L - z * se, ls = L + z * se)
graf4_2 <- ggplot(lorenz_df, aes(p, L, colour = pob, fill = pob)) +
geom_abline(slope = 1, linetype = "dashed", colour = "grey40") +
geom_ribbon(aes(ymin = li, ymax = ls), alpha = .2, colour = NA) +
geom_line() + geom_point(size = 1) +
facet_wrap(~anio) +
scale_colour_manual(values = c(Resto = "grey60",
`Hogares con 65+` = "#9b2247"),
aesthetics = c("colour", "fill")) +
labs(title = "Gráfica 4.2. Curva de Lorenz del ingreso corriente del hogar,\nhogares con 65+ y resto, 2022 y 2024",
x = "Proporción acumulada de hogares",
y = "Proporción acumulada del ingreso",
colour = NULL,
fill = NULL,
caption = paste("Nota: bandas = IC 95%. Hogares ordenados por ingreso corriente total dentro de cada dominio.",fuente, sep = "\n")) +
tema
graf4_2
saveRDS(list(indicadores = t4_ind, lorenz = lorenz_df, cotejo = cotejo, colas = colas,
graf4_1 = graf4_1, graf4_2 = graf4_2), "salidas/t4_resultados.rds")
#| label: t5-calculo
etq5 <- c(gini       = "Gini",
theil      = "Theil T",
media      = "Ingreso corriente medio (pesos de 2018)",
transfer   = "Peso de transferencias (%)",
jubilacion = "Peso de jubilaciones (%)",
bene_gob   = "Peso de programas gob. (%)")
# Indicadores de un grupo (65+ o resto) en un año
ind_t5 <- function(g) {
x <- list(svygini(~ing_cor, g),
svygei(~ing_cor, subset(g, ing_cor > 0), epsilon = 1),
svymean(~ing_cor, g),
svyratio(~transfer + jubilacion + bene_gob, ~ing_cor, g))
data.frame(ind = names(etq5),
est = unlist(lapply(x, coef), use.names = FALSE),
se  = unlist(lapply(x, \(o) as.numeric(SE(o))))) %>%
mutate(across(c(est, se),
~ if_else(ind %in% c("transfer",
"jubilacion",
"bene_gob"),
.x * 100, .x)))
}
# Prueba de diferencia entre años, se usa en los cuadros 5.1 y 5.2
prueba <- function(df) df %>%
pivot_wider(names_from = anio,
values_from = c(est, se),
names_vary = "slowest") %>%
mutate(dif = est_2024 - est_2022,
se_dif = sqrt(se_2022^2 + se_2024^2),
li = dif - z * se_dif,
ls = dif + z * se_dif,
p = 2 * pnorm(-abs(dif / se_dif)),
sig = if_else(p < .05, "Sí", "No"))
pobs5 <- list(`Hogares con 65+` = grupos,
Resto             = list(`2022` = subset(d22, g65 == 0),
`2024` = subset(d24, g65 == 0)))
t5_largo <- lapply(pobs5, \(ds) lapply(ds, ind_t5) %>%
bind_rows(.id = "anio")) %>%
bind_rows(.id = "pob")
t5_dif <- prueba(t5_largo) %>% mutate(ind = etq5[ind])
# Hogares en muestra con ingreso 0 que excluye el Theil (orden: grupo 22, grupo 24, resto 22, resto 24)
n_cero <- sapply(unlist(pobs5, recursive = FALSE),
\(d) sum(weights(d) > 0 & d$variables$ing_cor == 0))
#| label: t5-cuadro1
num <- c("est_2022",
"se_2022",
"est_2024",
"se_2024",
"dif",
"se_dif",
"li",
"ls")
# Formato común de los cuadros de cambio
ft_cambio <- function(df) flextable(df) %>%
set_header_labels(pob = "Población",
ind = "Indicador",
est_2022 = "Estimación",
se_2022 = "EE",
est_2024 = "Estimación",
se_2024 = "EE",
dif = "Δ",
se_dif = "EE",
li = "LI 95%",
ls = "LS 95%",
p = "p",
sig = "Signif. 5%") %>%
add_header_row(values = c("", "2022", "2024", "Cambio 2024 − 2022"),
colwidths = c(2, 2, 2, 6)) %>%
merge_v(j = "pob") %>%
theme_vanilla() %>%
hline(i = nrow(df) / 2)
cuadro5_1 <- ft_cambio(t5_dif) %>%
colformat_double(digits = 2, big.mark = ",") %>%
colformat_double(i = ~ ind %in% c("Gini", "Theil T"),
j = num, digits = 4) %>%
colformat_double(j = "p", digits = 3) %>%
set_caption("Cuadro 5.1. Cambio 2022–2024 en desigualdad, ingreso y peso de las transferencias: hogares con 65+ y resto de los hogares") %>%
add_footer_lines(c(
sprintf("Nota: ingreso corriente trimestral del hogar en pesos de 2018. Peso = Σ fuente / Σ ing_cor × 100 (razón de totales, no promedio de proporciones por hogar). Theil T excluye hogares con ingreso 0 (muestra, 2022 y 2024: grupo %d y %d; resto %d y %d). EE de la diferencia = √(EE²₂₀₂₂ + EE²₂₀₂₄), bajo el supuesto de muestras independientes; IC 95%% con aproximación normal. Varias pruebas sin corrección por comparaciones múltiples.",
n_cero[1], n_cero[2], n_cero[3], n_cero[4]), fuente)) %>%
fontsize(size = 9, part = "footer") %>%
autofit()
cuadro5_1
#| label: t5-grafica
graf5_1 <- t5_largo %>%
mutate(ind = factor(etq5[ind], etq5)) %>%
ggplot(aes(pob, est, color = anio)) +
geom_pointrange(aes(ymin = est - z * se, ymax = est + z * se),
position = position_dodge(width = .4)) +
facet_wrap(~ind, scales = "free_y", labeller = label_wrap_gen(25)) +
scale_color_manual(values = pal, name = NULL) +
labs(title = "Gráfica 5.1. Indicadores de hogares con 65+ y resto de los hogares, e IC 95%, ENIGH 2022 y 2024",
x = NULL, y = NULL,
caption = paste("Nota: que los IC se traslapen no implica que el cambio no sea significativo; ver Cuadro 5.1.",
fuente, sep = "\n")) +
tema
graf5_1
#| label: t5-sensibilidad
# Gini sin el hogar de mayor ingreso de cada población y año y Theil sin ceros, igual que en las estimaciones principales.
t5_sens <- lapply(c(`Hogares con 65+` = 1, Resto = 0),
\(k)
lapply(disenios, \(d) {
tope <- max(d$variables$ing_cor[d$variables$g65 == k])
desig(subset(d, g65 == k & ing_cor < tope))
}) %>% bind_rows(.id = "anio")) %>%
bind_rows(.id = "pob") %>%
select(pob, anio, ind, est, se) %>%
prueba()
cuadro5_2 <- ft_cambio(t5_sens) %>%
colformat_double(digits = 4) %>%
colformat_double(j = "p", digits = 3) %>%
set_caption("Cuadro 5.2. Sensibilidad del cambio 2022–2024 en Gini y Theil T a valores extremos: hogares con 65+ y resto de los hogares") %>%
add_footer_lines(c(
"Nota: se excluye, en cada población y año, el hogar con mayor ingreso corriente. Mismo procedimiento de prueba que el Cuadro 5.1. Análisis de robustez; las estimaciones principales son las del Cuadro 5.1.",
fuente)) %>%
fontsize(size = 9, part = "footer") %>%
autofit()
cuadro5_2
saveRDS(list(cambio = t5_dif, sensibilidad = t5_sens, largo = t5_largo,
n_cero = n_cero, graf5_1 = graf5_1), "salidas/t5_resultados.rds")
#| label: t6-control
esc <- c(Observado = "ing_cor",
`Sin programas gob.` = "ing_sin_bene",
`Sin jubilación` = "ing_sin_jub",
`Sin transferencias` = "ing_sin_trans")
dec <- c(Observado = "decil",
setNames(paste0("decil_", esc[-1]), names(esc)[-1]))
# Mínimo (debe ser ≥ 0), % de hogares con ingreso 0 y desbalance máximo de los deciles (puntos vs 10%)
t6_control <- lapply(list(`2022` = base22, `2024` = base24), function(b) data.frame(
escenario = names(esc),
minimo    = sapply(esc,
\(v) min(b[[v]])),
cero_pais = sapply(esc,
\(v) 100 * weighted.mean(b[[v]] == 0,
b$factor)),
cero_g65  = sapply(esc,
\(v) 100 * weighted.mean(b[[v]][b$g65 == 1] == 0,
b$factor[b$g65 == 1])),
desbal    = sapply(dec,
\(v) max(abs(100 * prop.table(tapply(b$factor,
b[[v]], sum)) - 10)
)
),
row.names = NULL
)
) %>%
bind_rows(.id = "anio")
t6_control
