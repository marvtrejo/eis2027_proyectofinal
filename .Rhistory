prec_jub_24  = "Precisión",
cv_bene_24   = "CV % Prog. (2024)",
prec_bene_24 = "Precisión"
) %>%
theme_vanilla() %>%
colformat_double(j = c("cv_jub_22", "cv_bene_22", "cv_jub_24", "cv_bene_24"), digits = 2) %>%
colformat_int(j = c("n_22", "n_24"), big.mark = ",") %>%
# Semáforo para 2022
bg(i = ~ cv_jub_22 >= 15 & cv_jub_22 < 30, j = "cv_jub_22", bg = "#FFF2CC") %>%
bg(i = ~ cv_jub_22 >= 30, j = "cv_jub_22", bg = "#FCE4D6") %>%
bg(i = ~ cv_bene_22 >= 15 & cv_bene_22 < 30, j = "cv_bene_22", bg = "#FFF2CC") %>%
bg(i = ~ cv_bene_22 >= 30, j = "cv_bene_22", bg = "#FCE4D6") %>%
# Semáforo para 2024
bg(i = ~ cv_jub_24 >= 15 & cv_jub_24 < 30, j = "cv_jub_24", bg = "#FFF2CC") %>%
bg(i = ~ cv_jub_24 >= 30, j = "cv_jub_24", bg = "#FCE4D6") %>%
bg(i = ~ cv_bene_24 >= 15 & cv_bene_24 < 30, j = "cv_bene_24", bg = "#FFF2CC") %>%
