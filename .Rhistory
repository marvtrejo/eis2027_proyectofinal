#| label: t2-combinacion
comb_t2 <- function(g) {
r <- svyby(~tipo_tr, ~decil, g, svymean)
tibble(id = names(coef(r)), p = 100 * coef(r), se = 100 * unlist(SE(r))) %>%
separate(id, c("decil", "tipo"), sep = ":tipo_tr") %>%
mutate(decil = as.integer(decil), tipo = factor(tipo, levels(base24$tipo_tr)),
cv = 100 * se / p, prec = precision(cv))
}
t2_comb <- lapply(grupos, comb_t2) %>% bind_rows(.id = "anio")
g_t2c <- ggplot(t2_comb, aes(factor(decil), p, fill = tipo)) +
geom_col(width = .75) + facet_wrap(~anio) +
scale_x_discrete(labels = as.roman(1:10)) +
scale_fill_manual(values = c(Ninguna = "grey85", `Solo jubilación` = "#d4a5b2",
`Solo programas` = "grey60", Ambas = "#9b2247")) +
labs(title = "Gráfica 2.3. Hogares con 65+ según tipo de transferencia, por decil nacional",
x = "Decil nacional de ingreso corriente del hogar", y = "% de hogares del grupo en el decil",
fill = NULL, caption = fuente) + tema
g_t2c
saveRDS(list(t2 = t2, t2_res = t2_res, t2_comb = t2_comb,
g_t2a = g_t2a, g_t2b = g_t2b, g_t2c = g_t2c), "salidas/t2_resultados.rds")
#| label: t3-descomp
pobs3 <- list(Nacional = disenios, `Hogares 65+` = grupos)
agrup <-
list("Nacional: 65+ vs resto"     = c("Nacional",    "g65f"),
"65+: tipo de transferencia" = c("Hogares 65+", "tipo_tr"),
"65+: ámbito (urbano/rural)" = c("Hogares 65+", "ambito"),
"65+: sexo de la jefatura"   = c("Hogares 65+", "jefatura"),
"65+: tipo × ámbito"         = c("Hogares 65+", "tipo_amb"))
etq_c <- c(total = "Total", within = "Dentro", between = "Entre")
# GE(0) y GE(1): total, dentro y entre, con EE del diseño.
t3 <- function(d, g) bind_rows(lapply(c(`GE(0)` = 0, `GE(1) Theil` = 1), function(e) {
r <- svygeidec(~ing_cor, g, subset(d, ing_cor > 0), epsilon = e)
stopifnot(abs(coef(r)[["within"]] + coef(r)[["between"]] - coef(r)[["total"]]) < 1e-8)
data.frame(comp = etq_c[names(coef(r))],
est = as.numeric(coef(r)),
se = as.numeric(SE(r)))
}), .id = "indice")
t3_desc <- lapply(agrup,
function(a) bind_rows(lapply(pobs3[[a[1]]],
t3,
g = reformulate(a[2])),
.id = "anio")) %>%
bind_rows(.id = "agrup") %>%
group_by(agrup, anio, indice) %>%
mutate(pct = 100 * est / est[comp == "Total"],
cv = 100 * se / est) %>%
ungroup()
# Hogares en muestra excluidos por ingreso ≤ 0, por población
excl <- sapply(list(`2022` = base22, `2024` = base24), function(b)
c(nac = sum(b$ing_cor <= 0), g65 = sum(b$ing_cor <= 0 & b$g65 == 1)))
prueba_jef <- lapply(grupos, function(g) {
tt <- svyttest(tot_integ ~ jefatura, g)            # estimate = Mujer − Hombre
ch <- svychisq(~jefatura + tipo_tr, g)             # Rao-Scott (F), ajustada por diseño
data.frame(prueba = c("Integrantes del hogar (t)", "Jefatura × tipo de transferencia (F)"),
dif    = c(unname(tt$estimate), NA),
estad  = c(unname(tt$statistic), unname(ch$statistic)),
p      = unname(c(tt$p.value, ch$p.value)))
}) %>% bind_rows(.id = "anio")
prueba_jef
