),
prec_grupo = case_when(
is.na(cv_grupo) ~ "-",
cv_grupo < 15 ~ "Alta",
cv_grupo < 30 ~ "Moderada",
TRUE ~ "Baja"
)
)
attr(out, "ttest") <- list(
dif = as.numeric(ttest$estimate),
ic  = confint(ttest),
p   = ttest$p.value
)
return(out)
}
# Ejecutar y unir ambos años
res_t1_lista <- lapply(list("2022" = d22, "2024" = d24), t1)
df_cuadro2 <- bind_rows(res_t1_lista, .id = "anio")
#| label: t1-funcion
# Función estandarizada para la Tarea 1
t1 <- function(d) {
d <- update(d, uno = 1)
# 1. Tamaños
tot_exp <- svyby(~uno, ~g65, d, svytotal, vartype = c("se", "cv"))
n_obs   <- svyby(~uno, ~g65, d, unwtd.count)
# Verificación
stopifnot(abs(sum(weights(d)) - sum(tot_exp$uno)) < 1e-4)
# 2. Medias y Coberturas
vars_t1 <- ~ing_cor + transfer + jubilacion + bene_gob + recibe_jub + recibe_bene + tot_integ + p65mas
med <- svyby(vars_t1, ~g65, d, svymean, vartype = c("se", "cv"))
# 3. Prueba t
ttest <- svyttest(tot_integ ~ g65, d)
# Estructurar Data Frame
# Resto (g65 = 0)
df_resto <- tibble(
indicador  = c("Hogares expandidos", "Muestra (n)", "Ingreso corriente medio",
"Transferencias medias", "Jubilaciones medias", "Programas gob. medios",
"Cobertura jubilación (%)", "Cobertura prog. gob (%)",
"Integrantes del hogar", "Personas 65+ por hogar"),
est_resto  = c(tot_exp$uno[1], n_obs[[2]][1], med$ing_cor[1], med$transfer[1],
med$jubilacion[1], med$bene_gob[1], med$recibe_jub[1] * 100,
med$recibe_bene[1] * 100, med$tot_integ[1], NA),
se_resto   = c(tot_exp$se[1], NA, med$se.ing_cor[1], med$se.transfer[1],
med$se.jubilacion[1], med$se.bene_gob[1], med$se.recibe_jub[1] * 100,
med$se.recibe_bene[1] * 100, med$se.tot_integ[1], NA),
cv_resto   = c(tot_exp$cv[1] * 100, NA, med$cv.ing_cor[1] * 100, med$cv.transfer[1] * 100,
med$cv.jubilacion[1] * 100, med$cv.bene_gob[1] * 100, med$cv.recibe_jub[1] * 100,
med$cv.recibe_bene[1] * 100, med$cv.tot_integ[1] * 100, NA)
)
# Grupo (g65 = 1)
df_grupo <- tibble(
est_grupo  = c(tot_exp$uno[2], n_obs[[2]][2], med$ing_cor[2], med$transfer[2],
med$jubilacion[2], med$bene_gob[2], med$recibe_jub[2] * 100,
med$recibe_bene[2] * 100, med$tot_integ[2], med$p65mas[2]),
se_grupo   = c(tot_exp$se[2], NA, med$se.ing_cor[2], med$se.transfer[2],
med$se.jubilacion[2], med$se.bene_gob[2], med$se.recibe_jub[2] * 100,
med$se.recibe_bene[2] * 100, med$se.tot_integ[2], med$se.p65mas[2]),
cv_grupo   = c(tot_exp$cv[2] * 100, NA, med$cv.ing_cor[2] * 100, med$cv.transfer[2] * 100,
med$cv.jubilacion[2] * 100, med$cv.bene_gob[2] * 100, med$cv.recibe_jub[2] * 100,
med$cv.recibe_bene[2] * 100, med$cv.tot_integ[2] * 100, med$cv.p65mas[2] * 100)
)
out <- bind_cols(df_resto, df_grupo) %>%
mutate(
prec_resto = case_when(
is.na(cv_resto) ~ "-",
cv_resto < 15 ~ "Alta",
cv_resto < 30 ~ "Moderada",
TRUE ~ "Baja"
),
prec_grupo = case_when(
is.na(cv_grupo) ~ "-",
cv_grupo < 15 ~ "Alta",
cv_grupo < 30 ~ "Moderada",
TRUE ~ "Baja"
)
)
attr(out, "ttest") <- list(
dif = as.numeric(ttest$estimate),
ic  = confint(ttest),
p   = ttest$p.value
)
return(out)
}
# Ejecutar y unir ambos años
res_t1_lista <- lapply(list("2022" = d22, "2024" = d24), t1)
df_cuadro2 <- bind_rows(res_t1_lista, .id = "anio")
#| label: cuadro-2
tt_22 <- attr(res_t1_lista[["2022"]], "ttest")
tt_24 <- attr(res_t1_lista[["2024"]], "ttest")
cuadro2 <- df_cuadro2 %>%
select(anio, indicador,
est_resto, se_resto, cv_resto, prec_resto,
est_grupo, se_grupo, cv_grupo, prec_grupo) %>%
flextable() %>%
set_header_labels(
anio       = "Año",
indicador  = "Indicador",
est_resto  = "Est. Resto",
se_resto   = "SE",
cv_resto   = "CV (%)",
prec_resto = "Precisión",
est_grupo  = "Est. Grupo",
se_grupo   = "SE",
cv_grupo   = "CV (%)",
prec_grupo = "Precisión"
) %>%
theme_vanilla() %>%
colformat_double(j = c("est_resto", "se_resto", "est_grupo", "se_grupo"), digits = 2, big.mark = ",") %>%
colformat_double(j = c("cv_resto", "cv_grupo"), digits = 2) %>%
# Semáforo para CV (%)
bg(i = ~ cv_resto >= 15 & cv_resto < 30, j = "cv_resto", bg = "#FFF2CC") %>%
bg(i = ~ cv_resto >= 30, j = "cv_resto", bg = "#FCE4D6") %>%
bg(i = ~ cv_grupo >= 15 & cv_grupo < 30, j = "cv_grupo", bg = "#FFF2CC") %>%
bg(i = ~ cv_grupo >= 30, j = "cv_grupo", bg = "#FCE4D6") %>%
set_caption("Cuadro 2. Tamaño de grupo y precisión de estimaciones con pesos trimestrales, ENIGH 2022 y 2024") %>%
add_footer_lines(c(
"Fuente: elaboración propia con datos de la ENIGH 2022 y 2024, INEGI."
)) %>%
fontsize(size = 9, part = "footer") %>%
autofit()
cuadro2
