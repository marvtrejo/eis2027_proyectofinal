lapply(bases, \(x) {
tope <- max(x[[2]]$ing_cor[x[[2]]$g65 == k])
s  <- subset(x[[1]], g65 == k & ing_cor > 0 & ing_cor < tope)
gi <- svygini(~ing_cor, s); th <- svygei(~ing_cor, s, epsilon = 1)
data.frame(ind = c("Gini", "Theil T"), est = c(coef(gi), coef(th)),
se = as.numeric(c(SE(gi), SE(th))))
