"salidas/t5_resultados.rds")
#| label: t5-calculo
# Indicadores del grupo por año (todo sobre el diseño: los EE salen de survey/convey)
etq5 <- c(gini       = "Gini",
theil      = "Theil T",
media      = "Ingreso corriente medio (pesos de 2018)",
transfer   = "Peso de transferencias (%)",
jubilacion = "Peso de jubilaciones (%)",
bene_gob   = "Peso de programas gob. (%)")
ind_t5 <- function(g) {
x <- list(svygini(~ing_cor, g),
svygei(~ing_cor, subset(g, ing_cor > 0), epsilon = 1),    # Theil excluye ceros
svymean(~ing_cor, g),
svyratio(~transfer + jubilacion + bene_gob, ~ing_cor, g)) # razón de totales
data.frame(ind = names(etq5),
est = unlist(lapply(x, coef), use.names = FALSE),
se  = unlist(lapply(x, \(o) as.numeric(SE(o))))) %>%
mutate(across(c(est, se), ~ if_else(ind %in% c("transfer", "jubilacion", "bene_gob"), .x * 100, .x)))
}
z <- qnorm(.975)
pobs <- list(`Hogares con 65+` = list(`2022` = g22, `2024` = g24),
Nacional          = list(`2022` = d22, `2024` = d24))
t5_largo <- lapply(pobs, \(ds) lapply(ds, ind_t5) %>% bind_rows(.id = "anio")) %>%
bind_rows(.id = "pob")
cuadro5_df <- t5_largo %>%
pivot_wider(names_from = anio, values_from = c(est, se)) %>%
mutate(dif    = est_2024 - est_2022,
se_dif = sqrt(se_2022^2 + se_2024^2),
li     = dif - z * se_dif,
ls     = dif + z * se_dif,
p      = 2 * pnorm(-abs(dif / se_dif)),
sig    = if_else(p < .05, "Sí", "No"),
ind    = etq5[ind]) %>%
select(pob, ind, est_2022, se_2022, est_2024, se_2024, dif, se_dif, li, ls, p, sig)
# Hogares con ingreso 0 que excluye el Theil (muestra), por población y año
n_cero <- sapply(unlist(pobs, recursive = FALSE), \(d) sum(model.frame(d)$ing_cor == 0))
#| label: t5-cuadro5
num <- c("est_2022", "se_2022", "est_2024", "se_2024", "dif", "se_dif", "li", "ls")
cuadro5 <- flextable(cuadro5_df) %>%
set_header_labels(pob = "Población", ind = "Indicador",
est_2022 = "Estimación", se_2022 = "EE",
est_2024 = "Estimación", se_2024 = "EE",
dif = "Δ", se_dif = "EE", li = "LI 95%", ls = "LS 95%",
p = "p", sig = "Signif. 5%") %>%
add_header_row(values = c("", "2022", "2024", "Cambio 2024 − 2022"), colwidths = c(2, 2, 2, 6)) %>%
merge_v(j = "pob") %>%
theme_vanilla() %>%
colformat_double(digits = 2, big.mark = ",") %>%
colformat_double(i = ~ ind %in% c("Gini", "Theil T"), j = num, digits = 4) %>%
colformat_double(j = "p", digits = 3) %>%
hline(i = nrow(cuadro5_df) / 2) %>%
set_caption("Cuadro 5. Cambio 2022–2024 en desigualdad, ingreso y peso de las transferencias: hogares con 65+ y total nacional") %>%
add_footer_lines(c(
sprintf("Nota: ingreso corriente trimestral del hogar en pesos de 2018. Peso = Σ fuente / Σ ing_cor × 100 (razón de totales, no promedio de proporciones por hogar). Theil T excluye hogares con ingreso 0 (muestra, 2022 y 2024: grupo %d y %d; nacional %d y %d). EE de la diferencia = √(EE²₂₀₂₂ + EE²₂₀₂₄), bajo el supuesto de muestras independientes; IC 95%% con aproximación normal. Nacional incluye a los hogares con 65+; la comparación entre poblaciones es descriptiva. Varias pruebas sin corrección por comparaciones múltiples.",
n_cero[1], n_cero[2], n_cero[3], n_cero[4]),
"Fuente: elaboración propia con datos de la ENIGH 2022 y 2024, INEGI.")) %>%
fontsize(size = 9, part = "footer") %>%
autofit()
cuadro5
