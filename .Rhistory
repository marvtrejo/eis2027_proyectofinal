#| label: t5-calculo
# Indicadores del grupo por año (todo sobre el diseño: los EE salen de survey/convey)
etq5 <- c(gini       = "Gini",
theil      = "Theil T",
media      = "Ingreso corriente medio (pesos de 2018)",
transfer   = "Peso de transferencias (%)",
jubilacion = "Peso de jubilaciones (%)",
bene_gob   = "Peso de programas gob. (%)")
ind_t5 <- function(g) {
x <- list(svygini(~ing_cor, g),
svygei(~ing_cor, subset(g, ing_cor > 0), epsilon = 1),    # Theil excluye ceros
svymean(~ing_cor, g),
svyratio(~transfer + jubilacion + bene_gob, ~ing_cor, g)) # razón de totales
data.frame(ind = names(etq5),
est = unlist(lapply(x, coef), use.names = FALSE),
se  = unlist(lapply(x, \(o) as.numeric(SE(o))))) %>%
mutate(across(c(est, se), ~ if_else(ind %in% c("transfer", "jubilacion", "bene_gob"), .x * 100, .x)))
}
z <- qnorm(.975)
t5_largo <- lapply(list(`2022` = g22, `2024` = g24), ind_t5) %>% bind_rows(.id = "anio")
# Diferencia entre encuestas independientes
cuadro5_df <- t5_largo %>%
pivot_wider(names_from = anio, values_from = c(est, se)) %>%
mutate(dif    = est_2024 - est_2022,
se_dif = sqrt(se_2022^2 + se_2024^2),
li     = dif - z * se_dif,
ls     = dif + z * se_dif,
p      = 2 * pnorm(-abs(dif / se_dif)),
sig    = if_else(p < .05, "Sí", "No"),
ind    = etq5[ind]) %>%
select(ind, est_2022, se_2022, est_2024, se_2024, dif, se_dif, li, ls, p, sig)
# Hogares que el Theil excluye por ingreso 0 (muestra)
n_cero <- sapply(list(`2022` = g22, `2024` = g24), \(g) sum(model.frame(g)$ing_cor == 0))
#| label: t5-cuadro5
cuadro5 <- flextable(cuadro5_df) %>%
set_header_labels(ind = "Indicador",
est_2022 = "Estimación", se_2022 = "EE",
est_2024 = "Estimación", se_2024 = "EE",
dif = "Δ", se_dif = "EE", li = "LI 95%", ls = "LS 95%",
p = "p", sig = "Signif. 5%") %>%
add_header_row(values = c("", "2022", "2024", "Cambio 2024 − 2022"), colwidths = c(1, 2, 2, 6)) %>%
theme_vanilla() %>%
colformat_double(digits = 2, big.mark = ",") %>%
colformat_double(i = 1:2, j = 2:9, digits = 4) %>%
colformat_double(j = "p", digits = 3) %>%
set_caption("Cuadro 5. Cambio 2022–2024 en desigualdad, ingreso y peso de las transferencias, hogares con 65+") %>%
add_footer_lines(c(
sprintf("Nota: ingreso corriente trimestral del hogar en pesos de 2018. Peso = Σ fuente / Σ ing_cor × 100 (razón de totales, no promedio de proporciones por hogar). Theil T excluye hogares con ingreso 0 (muestra: %d en 2022, %d en 2024). EE de la diferencia = √(EE²₂₀₂₂ + EE²₂₀₂₄), bajo el supuesto de muestras independientes; IC 95%% con aproximación normal. Varias pruebas sin corrección por comparaciones múltiples.",
n_cero[1], n_cero[2]),
"Fuente: elaboración propia con datos de la ENIGH 2022 y 2024, INEGI.")) %>%
fontsize(size = 9, part = "footer") %>%
autofit()
cuadro5
#| label: t5-grafica
graf5 <- t5_largo %>%
mutate(ind = factor(etq5[ind], etq5)) %>%
ggplot(aes(anio, est, color = anio)) +
geom_pointrange(aes(ymin = est - z * se, ymax = est + z * se)) +
facet_wrap(~ind, scales = "free_y", labeller = label_wrap_gen(25)) +
scale_color_manual(values = c(`2022` = "grey60", `2024` = "#9b2247"), guide = "none") +
labs(title = "Gráfica 1. Indicadores del grupo con 65+ e IC 95%, ENIGH 2022 y 2024",
x = NULL, y = NULL,
caption = "Nota: que los IC se traslapen no implica que el cambio no sea significativo; ver Cuadro 5.\nFuente: elaboración propia con datos de la ENIGH 2022 y 2024, INEGI.") +
theme_classic() +
theme(plot.caption.position = "plot", plot.caption = element_text(hjust = 0))
graf5
saveRDS(list(cuadro5 = cuadro5_df, largo = t5_largo, n_cero = n_cero, graf5 = graf5),
"salidas/t5_resultados.rds")
