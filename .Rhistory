#| label: t0-cotejo_inegi
# Cotejo con los tabulados básicos del INEGI (cuadro 3.1: hogares y su ingreso corriente total trimestral por deciles de hogares).
tab_inegi <- data.frame(anio    = c("2022", "2024"),
hogares = c(37560123, 38830230),
gini    = c(0.402, 0.391))
cotejo_inegi <- tab_inegi %>%
mutate(hogares_propio = sapply(list(base22, base24), \(b)
sum(b$factor)),
gini_propio    = sapply(list(base22, base24), \(b)
gini.wtd(b$ing_cor, b$factor)))
difiere <- with(cotejo_inegi,
abs(hogares_propio - hogares) > 0 |
abs(round(gini_propio, 3) - gini) > 0)
if (any(difiere, na.rm = TRUE))
warning("Las cifras propias no coinciden con los tabulados del INEGI; revisar cotejo_inegi.")
cuadro0_2_df <- with(cotejo_inegi, data.frame(
Indicador = rep(c("Hogares", "Coeficiente de Gini"), each = 2),
Año       = rep(anio, 2),
`Tabulado INEGI`    = c(hogares, gini),
`Estimación propia` = c(hogares_propio, gini_propio),
check.names = FALSE)) %>%
mutate(Diferencia = `Estimación propia` - `Tabulado INEGI`)
cuadro0_2 <- flextable(cuadro0_2_df) %>%
merge_v(j = "Indicador") %>%
estilo_ft() %>%
colformat_double(i = 1:2,
digits = 0,
big.mark = ",",
na_str = "ND") %>%
colformat_double(i = 3:4,
digits = 3,
na_str = "ND") %>%
titulo_ft("Cuadro 0.2 Cotejo con los tabulados básicos de la ENIGH (INEGI)") %>%
add_footer_lines(c(
"Nota: tabulado = hogares y su ingreso corriente total trimestral por deciles de hogares (cuadro 3.1 de los tabulados básicos). Gini del ingreso corriente total del hogar con factor de expansión (dineq::gini.wtd); por ser invariante a la escala, la deflactación no lo altera. ND: no disponible.",
fuente)) %>%
pie_ft() %>%
autofit()
cuadro0_2
saveRDS(cuadro0_2_df, "salidas/t0_cotejo_inegi.rds")
