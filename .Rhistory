cuadro5_w <- cuadro5_df %>%
pivot_wider(names_from = anio, values_from = c(est, se, cv, prec, excl), names_vary = "slowest")
cuadro5 <- flextable(cuadro5_w) %>%
set_header_labels(values = c(pob = "Hogares", ind = "Indicador", setNames(
rep(c("Estimación", "EE", "CV (%)", "Precisión", "Excluidos (n)"), 2), names(cuadro5_w)[-(1:2)]))) %>%
add_header_row(values = c("", "2022", "2024"), colwidths = c(2, 5, 5)) %>%
merge_v(j = "pob") %>%
theme_vanilla() %>%
colformat_double(digits = 4) %>%
colformat_double(j = c("cv_2022", "cv_2024"), digits = 2) %>%
semaforo(c("cv_2022", "cv_2024")) %>%
set_caption("Cuadro 5. Coeficiente de Gini e índice de Theil T del ingreso corriente del hogar, ENIGH 2022 y 2024") %>%
add_footer_lines(c(
"Nota: ingreso corriente total trimestral del hogar, sin ajuste por tamaño. Cada indicador mide la desigualdad dentro de su dominio. Gini con todos los hogares; Theil T solo con hogares de ingreso > 0 (Excluidos = hogares en muestra con ingreso 0). EE por linealización con el diseño muestral (convey). Precisión según criterio INEGI: alta CV < 15, moderada 15 ≤ CV < 30, baja CV ≥ 30.",
"Fuente: elaboración propia con datos de la ENIGH 2022 y 2024, INEGI.")) %>%
fontsize(size = 9, part = "footer") %>%
autofit()
cuadro5
#| label: t4-grafica1
z <- qnorm(.975)
grafica1 <- ggplot(cuadro5_df, aes(pob, est, colour = anio)) +
geom_pointrange(aes(ymin = est - z * se, ymax = est + z * se), position = position_dodge(.4)) +
facet_wrap(~ind, scales = "free_y") +
scale_colour_manual(values = c(`2022` = "grey60", `2024` = "#9b2247")) +
labs(title = "Gráfica 1. Gini y Theil T del ingreso corriente del hogar por dominio, 2022 y 2024",
x = NULL, y = "Estimación", colour = "Año",
caption = paste("Nota: barras = IC 95%. Que los intervalos no se traslapen no equivale a una prueba de diferencia (ver Tarea 5).",
"Fuente: elaboración propia con datos de la ENIGH 2022 y 2024, INEGI.", sep = "\n")) +
theme_classic() +
theme(legend.position = "bottom", plot.caption.position = "plot", plot.caption = element_text(hjust = 0))
grafica1
#| label: t4-lorenz
p <- seq(0, 1, .1)
lorenz <- function(d) {
l <- svylorenz(~ing_cor, d, quantiles = p, plot = FALSE)
stopifnot(length(coef(l)) == length(p))      # avisa si la versión de convey cambia la salida
data.frame(p, L = as.numeric(coef(l)), se = as.numeric(SE(l)))
}
lorenz_df <- lapply(disenios, function(d) bind_rows(lapply(dominios(d)[-1], lorenz), .id = "pob")) %>%
bind_rows(.id = "anio") %>%
mutate(li = L - z * se, ls = L + z * se)
grafica2 <- ggplot(lorenz_df, aes(p, L, colour = pob, fill = pob)) +
geom_abline(slope = 1, linetype = "dashed", colour = "grey40") +
geom_ribbon(aes(ymin = li, ymax = ls), alpha = .2, colour = NA) +
geom_line() + geom_point(size = 1) +
facet_wrap(~anio) +
scale_colour_manual(values = c(Resto = "grey60", `Hogares con 65+` = "#9b2247"),
aesthetics = c("colour", "fill")) +
labs(title = "Gráfica 2. Curva de Lorenz del ingreso corriente del hogar,\nhogares con 65+ y resto, 2022 y 2024",
x = "Proporción acumulada de hogares", y = "Proporción acumulada del ingreso",
colour = NULL, fill = NULL,
caption = paste("Nota: bandas = IC 95%. Hogares ordenados por ingreso corriente total dentro de cada dominio.",
"Fuente: elaboración propia con datos de la ENIGH 2022 y 2024, INEGI.", sep = "\n")) +
theme_classic() +
theme(legend.position = "bottom", plot.caption.position = "plot", plot.caption = element_text(hjust = 0))
grafica2
saveRDS(list(cuadro5 = cuadro5_df, lorenz = lorenz_df, cotejo = cotejo,
grafica1 = grafica1, grafica2 = grafica2), "salidas/t4_resultados.rds")
#| label: t4-colas
# Diagnóstico exploratorio: hogares con mayor ingreso y su peso en el ingreso total expandido
colas <- lapply(list(`2022` = base22, `2024` = base24), function(b) b %>%
slice_max(ing_cor, n = 5) %>%
transmute(ing_cor, factor, g65, upm, est_dis,
peso_pct = 100 * ing_cor * factor / sum(b$ing_cor * b$factor))) %>%
bind_rows(.id = "anio")
colas
# Sensibilidad: Theil del resto sin el hogar de mayor ingreso (solo diagnóstico, no sustituye la estimación)
sens <- lapply(disenios, function(d) desig(subset(d, g65 == 0 & ing_cor < max(ing_cor)))) %>%
bind_rows(.id = "anio")
sens
