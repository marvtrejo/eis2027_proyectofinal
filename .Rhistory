select(ing_cor, factor, tot_integ, ingtrab, rentas) %>% head(10)
base24 %>% filter(g65 == 0) %>% arrange(desc(ing_cor)) %>% slice(5) %>%
select(ing_cor, transfer, jubilacion, bene_gob, remesas, donativos, estim_alqu, otros_ing)
tope <- max(base24$ing_cor[base24$g65 == 0])
r24  <- subset(d24, g65 == 0 & ing_cor > 0 & ing_cor < tope)
svygei(~ing_cor, r24, epsilon = 1); svygini(~ing_cor, r24)
sens <- function(d, b, k) {
tope <- max(b$ing_cor[b$g65 == k])
s <- subset(d, g65 == k & ing_cor > 0 & ing_cor < tope)
rbind(Gini = c(coef(svygini(~ing_cor, s)), SE(svygini(~ing_cor, s))),
Theil = c(coef(svygei(~ing_cor, s, epsilon = 1)), SE(svygei(~ing_cor, s, epsilon = 1))))
}
lapply(c(resto = 0, grupo = 1), \(k) list(`2022` = sens(d22, base22, k), `2024` = sens(d24, base24, k)))
