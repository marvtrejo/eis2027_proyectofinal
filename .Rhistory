dif = "Δ", se_dif = "EE", li = "LI 95%", ls = "LS 95%",
p = "p", sig = "Signif. 5%") %>%
add_header_row(values = c("", "2022", "2024", "Cambio 2024 − 2022"), colwidths = c(1, 2, 2, 6)) %>%
theme_vanilla() %>%
colformat_double(digits = 2, big.mark = ",") %>%
