set_header_labels(anio = "Año", indicador = "Indicador", pct = "%", se = "EE",
li = "LI 95%", ls = "LS 95%", cv = "CV (%)", precision = "Precisión") %>%
merge_v(j = "anio") %>%
colformat_double(digits = 1) %>%
set_caption("Cuadro 2.3. Concentración del grupo en los extremos de la distribución, ENIGH 2022 y 2024") %>%
add_footer_lines(c(nota_cv, fuente)) %>% fontsize(size = 9, part = "footer") %>% autofit()
