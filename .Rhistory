set_caption("Cuadro 3. Coeficiente de variación (%) y precisión por decil dentro del grupo de interés, ENIGH 2022 y 2024") %>%
add_footer_lines("Fuente: elaboración propia con datos de la ENIGH 2022 y 2024, INEGI.") %>%
fontsize(size = 9, part = "footer") %>%
