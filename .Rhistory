set_caption("Cuadro 5. Cambio 2022–2024 en desigualdad, ingreso y peso de las transferencias, hogares con 65+") %>%
add_footer_lines(c(
sprintf("Nota: ingreso corriente trimestral del hogar en pesos de 2018. Peso = Σ fuente / Σ ing_cor × 100 (razón de totales, no promedio de proporciones por hogar). Theil T excluye hogares con ingreso 0 (muestra: %d en 2022, %d en 2024). EE de la diferencia = √(EE²₂₀₂₂ + EE²₂₀₂₄), bajo el supuesto de muestras independientes; IC 95%% con aproximación normal. Varias pruebas sin corrección por comparaciones múltiples.",
n_cero[1], n_cero[2]),
